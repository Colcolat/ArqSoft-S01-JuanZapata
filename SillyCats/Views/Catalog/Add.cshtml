@model SillyCats.Models.Item

<h1>Add a Silly Cat</h1>

<form asp-action="Add" method="post">
    <div>
        <label>Name</label>
        <input asp-for="Name"/>
    </div>
    <div>
        <label>Breed</label>
        <input asp-for="Breed"/>
    </div>
    <div>
        <label>Gender</label>
        <input asp-for="Gender"/>
    </div>
    <div>
        <label>Personality</label>
        <input asp-for="Personality"/>
    </div>
    <div>
        <label>Description</label>
        <input asp-for="Description"/>
    </div>
</form>